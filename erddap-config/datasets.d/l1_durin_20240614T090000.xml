<!-- See ../datasets_example.xml for full annotation/reasoning -- this is the
     bare fragment as axiom/docker-erddap's datasets.d mode expects: a raw
     <dataset> block, no <erddapDatasets> wrapper. Files here get sorted by
     path and concatenated into the real datasets.xml at container start. -->
<dataset type="EDDTableFromNcCFFiles" datasetID="l1_durin_20240614T090000" active="true">

  <reloadEveryNMinutes>1440</reloadEveryNMinutes>
  <fileDir>/data/ogdp/processed/L1/durin_20240614T090000/</fileDir>
  <fileNameRegex>.*\.nc</fileNameRegex>
  <recursive>false</recursive>
  <pathRegex>.*</pathRegex>
  <metadataFrom>last</metadataFrom>
  <standardizeWhat>0</standardizeWhat>
  <sortedColumnSourceName>time</sortedColumnSourceName>
  <sortFilesBySourceNames>time</sortFilesBySourceNames>
  <fileTableInMemory>false</fileTableInMemory>

  <addAttributes>
    <att name="cdm_data_type">Trajectory</att>
    <att name="cdm_trajectory_variables">trajectory</att>
    <att name="subsetVariables">trajectory</att>
    <att name="Conventions">CF-1.10, ACDD-1.3</att>
    <att name="featureType">trajectory</att>
    <att name="infoUrl">https://ogf.uib.no</att>
    <att name="institution">University of Bergen, Ocean Glider Facility</att>
    <att name="sourceUrl">(local files)</att>
    <att name="title">Durin (Slocum G3) mission 2024-06-14 -- L1 processed timeseries</att>
    <att name="summary">Processed (L1) timeseries from Slocum glider "Durin", mission starting 2024-06-14T09:00:00Z. Sensor timeseries interpolated to a common time base; QC flags applied per variable.</att>
    <att name="region">iceland_sea</att>
  </addAttributes>

  <dataVariable>
    <sourceName>trajectory</sourceName>
    <destinationName>trajectory</destinationName>
    <dataType>String</dataType>
    <addAttributes>
      <att name="cf_role">trajectory_id</att>
      <att name="ioos_category">Identifier</att>
      <att name="long_name">Trajectory/Deployment Name</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>time</sourceName>
    <destinationName>time</destinationName>
    <dataType>double</dataType>
    <addAttributes>
      <att name="units">seconds since 1970-01-01T00:00:00Z</att>
      <att name="standard_name">time</att>
      <att name="ioos_category">Time</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>latitude</sourceName>
    <destinationName>latitude</destinationName>
    <dataType>double</dataType>
    <addAttributes>
      <att name="units">degrees_north</att>
      <att name="standard_name">latitude</att>
      <att name="ioos_category">Location</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>longitude</sourceName>
    <destinationName>longitude</destinationName>
    <dataType>double</dataType>
    <addAttributes>
      <att name="units">degrees_east</att>
      <att name="standard_name">longitude</att>
      <att name="ioos_category">Location</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>depth</sourceName>
    <destinationName>depth</destinationName>
    <dataType>double</dataType>
    <addAttributes>
      <att name="units">m</att>
      <att name="standard_name">depth</att>
      <att name="ioos_category">Location</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>pressure</sourceName>
    <destinationName>pressure</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">dbar</att>
      <att name="standard_name">sea_water_pressure</att>
      <att name="long_name">water pressure</att>
      <att name="ioos_category">Pressure</att>
      <att name="ancillary_variables">pressure_qc</att>
      <att name="instrument">instrument_ctd</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>temperature</sourceName>
    <destinationName>temperature</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">Celsius</att>
      <att name="standard_name">sea_water_temperature</att>
      <att name="long_name">water temperature</att>
      <att name="ioos_category">Temperature</att>
      <att name="ancillary_variables">temperature_qc</att>
      <att name="instrument">instrument_ctd</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>conductivity</sourceName>
    <destinationName>conductivity</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">S m-1</att>
      <att name="standard_name">sea_water_electrical_conductivity</att>
      <att name="long_name">water conductivity</att>
      <att name="ioos_category">Salinity</att>
      <att name="ancillary_variables">conductivity_qc</att>
      <att name="instrument">instrument_ctd</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>salinity</sourceName>
    <destinationName>salinity</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">1</att>
      <att name="standard_name">sea_water_practical_salinity</att>
      <att name="long_name">water salinity</att>
      <att name="ioos_category">Salinity</att>
      <att name="ancillary_variables">salinity_qc</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>potential_density</sourceName>
    <destinationName>potential_density</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">kg m-3</att>
      <att name="standard_name">sea_water_potential_density</att>
      <att name="long_name">water potential density</att>
      <att name="ioos_category">Physical Oceanography</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>chlorophyll</sourceName>
    <destinationName>chlorophyll</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">mg m-3</att>
      <att name="standard_name">concentration_of_chlorophyll_in_sea_water</att>
      <att name="long_name">chlorophyll</att>
      <att name="ioos_category">Ocean Color</att>
      <att name="ancillary_variables">chlorophyll_qc</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>oxygen_concentration</sourceName>
    <destinationName>oxygen_concentration</destinationName>
    <dataType>float</dataType>
    <addAttributes>
      <att name="units">umol l-1</att>
      <att name="standard_name">mole_concentration_of_dissolved_molecular_oxygen_in_sea_water</att>
      <att name="long_name">oxygen concentration</att>
      <att name="ioos_category">Dissolved O2</att>
      <att name="ancillary_variables">oxygen_concentration_qc</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>temperature_qc</sourceName>
    <destinationName>temperature_qc</destinationName>
    <dataType>byte</dataType>
    <addAttributes>
      <att name="long_name">Initial flag for temperature</att>
      <att name="standard_name">quality_flag</att>
      <att name="flag_values" type="byteList">1 2 3 4 9</att>
      <att name="flag_meanings">PASS NOT_EVALUATED SUSPECT FAIL MISSING</att>
      <att name="valid_min" type="byte">1</att>
      <att name="valid_max" type="byte">9</att>
      <att name="ioos_category">Quality</att>
    </addAttributes>
  </dataVariable>

  <dataVariable>
    <sourceName>salinity_qc</sourceName>
    <destinationName>salinity_qc</destinationName>
    <dataType>byte</dataType>
    <addAttributes>
      <att name="long_name">Initial flag for salinity</att>
      <att name="standard_name">quality_flag</att>
      <att name="flag_values" type="byteList">1 2 3 4 9</att>
      <att name="flag_meanings">PASS NOT_EVALUATED SUSPECT FAIL MISSING</att>
      <att name="valid_min" type="byte">1</att>
      <att name="valid_max" type="byte">9</att>
      <att name="ioos_category">Quality</att>
    </addAttributes>
  </dataVariable>

  <!-- ... repeat for pressure_qc, conductivity_qc, chlorophyll_qc,
       oxygen_concentration_qc -- same pattern, only varname/long_name change ... -->

</dataset>
